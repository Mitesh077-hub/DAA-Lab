// Backtracking function
void find_subsets(int *set, int n, int target, int index, int current_sum) {
    // Base Case: Target sum reached
    if (current_sum == target) {
        store_subset();
        return;
    }
    
    // Base Case: Out of bounds or sum exceeded
    if (index >= n || current_sum > target) {
        return;
    }
    
    // Option 1: Include the current element
    current_subset[subset_size++] = set[index];
    find_subsets(set, n, target, index + 1, current_sum + set[index]);
    subset_size--; // Backtrack
    
    // Option 2: Exclude the current element
    find_subsets(set, n, target, index + 1, current_sum);
}

int main() {
    int n;
    if (scanf("%d", &n) != 1) return 0;
    
    int *set = malloc(n * sizeof(int));
    for (int i = 0; i < n; i++) {
        if (scanf("%d", &set[i]) != 1) return 0;
    }
    
    int target_sum;
    if (scanf("%d", &target_sum) != 1) return 0;
    
    // Allocate memory for tracking paths
    current_subset = malloc(n * sizeof(int));
    results = malloc(max_results * sizeof(int *));
    
    // Find all matching subsets
    find_subsets(set, n, target_sum, 0, 0);
    
    // Print results or -1 if none exist
    if (result_count == 0) {
        printf("-1\n");
    } else {
        // Print in reverse order of discovery
        for (int i = result_count - 1; i >= 0; i--) {
            int size = results[i][0];
            for (int j = 1; j <= size; j++) {
                printf("%d", results[i][j]);
                if (j < size) {
                    printf(" ");
                }
            }
            printf(" \n");
            free(results[i]); // Clean up row memory
        }
    }
    
    // Free allocated memory
    free(set);
    free(current_subset);
    free(results);
    
    return 0;
}
